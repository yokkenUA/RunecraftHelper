<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1701;1702; 1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(GameHelperCoreDir)\GameHelper\GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Recipe data built by build_recipes_json.py from game_dat/. Bundled with the plugin. -->
    <Content Include="expedition2_recipes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- English display names for ExpeditionRelic buff mods, keyed by language-independent mod Id. Edit freely. -->
    <Content Include="relic_mods_en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Rune display names extracted from the local game Mods.datc64 language data. -->
    <Content Include="json\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>json\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!-- Reward-marker icons sliced from the game minimap sheet by extract_minimap_icons.py. -->
    <Content Include="icons\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>icons\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(TargetName)$(TargetExt);$(OutDir)$(TargetName).pdb;$(OutDir)expedition2_recipes.json;$(OutDir)relic_mods_en.json;" DestinationFolder="$(GameHelperPluginDeployDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <RuneJsonFiles Include="$(OutDir)json\**\*.json" />
      <RewardIconFiles Include="$(OutDir)icons\**\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(RuneJsonFiles)" DestinationFolder="$(GameHelperPluginDeployDir)\json\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RewardIconFiles)" DestinationFolder="$(GameHelperPluginDeployDir)\icons\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
