<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline harness for the Expedition route planner. Compiles the plugin's OWN sources into a console app
       so the simulation exercises the real valuation/gating/routing code (see Sim/SimHooks.cs). Never loaded
       by GameHelper; the plugin csproj excludes Sim\** so nothing here ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>1701;1702;1591</NoWarn>
    <AssemblyName>ExpeditionSim</AssemblyName>
    <RootNamespace>RunecraftHelper.Sim</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GameHelper\GameHelper.csproj" />
  </ItemGroup>

</Project>
